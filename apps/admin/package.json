{
  "name": "@ten/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "dev:worker": "wrangler dev --env staging --port 8788",
    "build": "vite build",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply ten-db-staging --local --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply ten-db-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply ten-db-production --remote --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@ten/oauth": "workspace:*",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
