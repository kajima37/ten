VITE_API_URL=http://localhost:8787

# Base URL of the legal pages (privacy policy, terms).
# The GitHub Pages build (no API mode) links to the staging Worker by default.
VITE_LEGAL_BASE_URL=https://ten-api-staging.kajima37.workers.dev

# AdMob
