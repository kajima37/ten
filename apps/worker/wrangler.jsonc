{
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "env": {
    "staging": {
      "name": "ten-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ten-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "remote": true,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "DAILY_CACHE",
          "id": "00000000000000000000000000000000",
          "remote": true,
        },
      ],
    },
    "production": {
      "name": "ten-api-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ten-db-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
          "remote": true,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "DAILY_CACHE",
          "id": "00000000000000000000000000000000",
          "remote": true,
        },
      ],
    },
  },
}
