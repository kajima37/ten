{
  "name": "ten",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @ten/web dev",
    "dev:worker": "pnpm --filter @ten/worker dev",
    "generate-routes": "pnpm --filter @ten/web generate-routes",
    "build": "pnpm --filter @ten/web build",
    "build:pages": "pnpm --filter @ten/web build:pages",
    "build:mobile": "pnpm --filter @ten/web build:mobile",
    "mobile:sync": "pnpm --filter @ten/web mobile:sync",
    "mobile:copy": "pnpm --filter @ten/web mobile:copy",
    "mobile:open:android": "pnpm --filter @ten/web mobile:open:android",
    "mobile:open:ios": "pnpm --filter @ten/web mobile:open:ios",
    "preview": "pnpm --filter @ten/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/node": "^22.10.2",
    "eslint": "^10.9.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  }
}
